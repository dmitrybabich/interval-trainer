{
  "name": "interval-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web-based vocal interval trainer — sing intervals, get real-time pitch feedback.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
